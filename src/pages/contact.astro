---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contactez la rédaction de MondeLume.">
	<article class="info-page shell section-pad">
		<p class="kicker">Nous écrire</p>
		<h1>Une idée,<br />une adresse ?</h1>
		<div class="info-content">
			<p class="info-lead">La rédaction lit chaque message avec attention.</p>
			<div>
				<p>Questions générales et suggestions éditoriales :</p>
				<p><a class="text-link dark" href="mailto:bonjour@mondelume.com">bonjour@mondelume.com <span>↗</span></a></p>
				<p>Pour une proposition de collaboration, indiquez clairement le contexte et les éventuels liens commerciaux.</p>
			</div>
		</div>
	</article>
</BaseLayout>
